LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DB_PATH=data/blackbox.db
DATA_DIR=data
ARTIFACTS_DIR=artifacts
MAX_CONCURRENCY=4
RPM_LIMIT=30
HOLDOUT_FAULTS=BAD_QUERY,WRONG_EXTRACTION
N_TASKS=300
BLACKBOX_DEMO_MODE=0
BLACKBOX_MOCK_API=0
# Demo-only judge login. Replace with managed identity before production use.
DEMO_AUTH_ENABLED=1
DEMO_AUTH_EMAIL=blackbox@gmail.com
DEMO_AUTH_PASSWORD=blackbox123
DEMO_AUTH_SECRET=replace-with-a-long-random-value
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_STARTTLS=0
SMTP_SSL=1
SMTP_FROM="Black Box <onboarding@resend.dev>"
APP_BASE_URL=http://localhost:5173
COST_PER_WRONG_ANSWER_INR=450
NOTIFY_DEFAULT_EMAIL=
NOTIFY_THROTTLE_MINUTES=30
DIGEST_HOUR_LOCAL=9
# Resend's onboarding domain can send only to the account owner's address.
# Use a verified domain in SMTP_FROM before sending to other recipients.
SEED=42
