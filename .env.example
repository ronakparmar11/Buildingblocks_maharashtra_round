LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
DB_PATH=data/blackbox.db
DATA_DIR=data
ARTIFACTS_DIR=artifacts
MAX_CONCURRENCY=4
RPM_LIMIT=30
HOLDOUT_FAULTS=BAD_QUERY,WRONG_EXTRACTION
N_TASKS=300
BLACKBOX_DEMO_MODE=0
BLACKBOX_MOCK_API=0
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=0
SMTP_SSL=0
SMTP_FROM="Black Box <alerts@blackbox.local>"
APP_BASE_URL=http://localhost:5173
COST_PER_WRONG_ANSWER_INR=450
NOTIFY_DEFAULT_EMAIL=support-ai@nimbu.local
NOTIFY_THROTTLE_MINUTES=30
DIGEST_HOUR_LOCAL=9
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_STARTTLS=1
# Set SMTP_USER and an app password in SMTP_PASSWORD; never commit either value.
SEED=42
